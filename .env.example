# Application
PROJECT_NAME="BusGo API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=busgo_user
POSTGRES_PASSWORD=superuser
POSTGRES_DB=busgo_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
SECRET_KEY=change_this_to_a_very_secret_and_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7